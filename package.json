{
  "name": "/app",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "concurrently": "^9.2.0"
  },
  "dependencies": {
    "ytdl-core": "^4.11.5"
  },
  "scripts": {
    "start:player": "bun --cwd packages/player dev",
    "start:streamer": "bun --cwd packages/streamer dev",
    "start": "concurrently \"bun run start:player\" \"bun run start:streamer\""
  },
  "workspaces": [
    "packages/*"
  ]
}
